# Ignore Excel workbooks and temporary Excel files
*.xlsx
~$*.xlsx

# Python cache files
__pycache__/
*.py[cod]

# Ignore email template files
EXTERNAL EMAIL TEMPLATES/*.eml
*.eml

# Ignore runtime output folders but keep placeholder .gitkeep files tracked
READY EMAILS/*
!READY EMAILS/.gitkeep

TEMP EXCEL PASSWORDS/*
!TEMP EXCEL PASSWORDS/.gitkeep
